@model UpdateBannerDto

@{
    ViewData["Title"] = "CreateBanner";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Banner Güncelleme Formu</h4>
                        <p class="card-subtitle mb-4">Bu formu kullanarak sisteminizdeki banner özelliğini güncelleyebilirsiniz.</p>
                        <form method="post" asp-area="Admin" asp-controller="AdminBanner" asp-action="UpdateBanner">
                            <input type="hidden" asp-for="BannerId" />
                            <div class="form-group">
                                <label for="exampleInputTitle">Başlık</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="Title" placeholder="Banner başlığını giriniz...">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputDesc">İçerik</label>
                                <textarea rows="4" class="form-control" id="exampleInputDesc" asp-for="Description" placeholder="Banner içeriğini giriniz..."></textarea>
                            </div>
                            <div class="form-group">
                                <label for="exampleInputVideoDesc">Video İçeriği</label>
                                <input type="text" class="form-control" id="exampleInputVideoDesc" asp-for="VideoDescription" placeholder="Video içeriğini giriniz...">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputFeature">Video Dosya Yolu</label>
                                <input type="text" class="form-control" id="exampleInputModel" asp-for="VideoUrl" placeholder="Video dosya yolunu giriniz...">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Güncelle</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

