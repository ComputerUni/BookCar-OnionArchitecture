@model UpdateLocationDto

@{
    ViewData["Title"] = "UpdateLocation";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Lokasyon Güncelleme Formu</h4>
                        <p class="card-subtitle mb-4">Bu formu kullanarak sisteminizdeki lokasyon bilgisini güncelleyebilirsiniz.</p>
                        <form method="post" asp-area="Admin" asp-controller="AdminLocation" asp-action="UpdateLocation">
                            <input type="hidden" asp-for="LocationId" />
                            <div class="form-group">
                                <label for="exampleInputTitle">Lokasyon</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="Name" placeholder="Lokasyonu giriniz...">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Güncelle</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
