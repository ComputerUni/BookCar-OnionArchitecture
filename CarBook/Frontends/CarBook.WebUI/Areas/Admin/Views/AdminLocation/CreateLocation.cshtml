@model CreateLocationDto

@{
    ViewData["Title"] = "CreateLocation";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Lokasyon Ekleme Formu</h4>
                        <p class="card-subtitle mb-4">Bu formu kullanarak sisteminize yeni lokasyon ekleyebilirsiniz.</p>
                        <form method="post" asp-area="Admin" asp-controller="AdminLocation" asp-action="CreateLocation">
                            <div class="form-group">
                                <label for="exampleInputTitle">Lokasyon</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="Name" placeholder="Lokasyonu giriniz...">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
