@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="mt-3">
                                <h4 class="card-title">Hakkımda Listesi</h4>
                                <p class="card-subtitle mb-4"><code class="text-info font-weight-bold">Hakkımda ile ilgili işlemlerinizi buradan gerçekleştirebilirsiniz.</code></p>
                            </div>

                            @if (!Model.Any() || Model == null)
                            {
                                <div class="mt-3">
                                    <a href="/Admin/AdminAbout/CreateAbout" class="btn btn-outline-info"><i class="fa fa-plus"></i> Yeni Hakkımda</a>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info" role="alert">
                                    Yeni Hakkımda Eklemek İçin Mevcut Hakkımda Bilgisini Siliniz
                                </div>
                            }

                        </div>
                        @if (Model.Any() && Model != null)
                        {
                            <div class="table-responsive">

                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Başlık</th>
                                            <th>Açıklama</th>
                                            <th>İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            count++;
                                            <tr>
                                                <th scope="row">@count</th>
                                                <td>@item.title</td>
                                                <td>@(item.description.Length > 100 ? item.description.Substring(0, 100) + "" + "..." : item.description)</td>
                                                <td>
                                                    <a href="/Admin/AdminAbout/RemoveAbout/@item.aboutId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                                    <a href="/Admin/AdminAbout/UpdateAbout/@item.aboutId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                                    <a href="/Admin/AdminAbout/UpdateAbout/@item.aboutId" class="btn btn-outline-secondary"><i class="fas fa-tv"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                Herhangi bir hakkımda bilgisi bulunamadı.
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>