@model List<ResultFeatureDto>

@{
    ViewData["Title"] = "Araç Özellikleri Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="card-title mb-1 font-weight-bold text-dark">Araca Ait Özellik Ekleme Sayfası</h4>
                                <p class="text-muted small mb-0">Araca ait özellik tanımlaması yapılacak sayfadır.</p>
                            </div>
                            <span class="badge bg-light text-primary border px-3 py-2">
                                Toplam: <strong>@(Model?.Count ?? 0)</strong> Özellik
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        @if (Model != null && Model.Any())
                        {
                            <form method="post">
                                <div class="row g-3">
                                    @for (int i = 0; i < Model.Count; i++)
                                    {
                                        <div class="col-sm-6 col-md-4 col-xl-3">
                                            <div class="border rounded p-3 h-100 bg-light-subtle">
                                                <input type="hidden" asp-for="@Model[i].FeatureId" />
                                                <input type="hidden" asp-for="@Model[i].Name" />

                                                <div class="d-flex align-items-center">
                                                    <input type="checkbox" style="cursor: pointer; width: 18px; height: 18px; flex-shrink: 0; margin: 0;" />

                                                    <label class="font-weight-semibold text-truncate mb-0" style="margin-left: 12px; cursor: pointer; user-select: none;">@Model[i].Name</label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <hr class="my-4 text-muted" />

                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/AdminCar/Index" class="btn btn-light border px-4">İptal / Geri Dön</a>
                                    <button type="submit" class="btn btn-outline-secondary px-4 shadow-sm">
                                        <i class="ri-save-line me-1"></i> Araca Özellikleri Ekle
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning border-0 d-flex align-items-center mb-0" role="alert">
                                <div>
                                    <h5 class="alert-heading mb-1">Kayıt Bulunamadı</h5>
                                    <p class="mb-0">Bu araca atanmış herhangi bir donanım/özellik kaydı bulunmamaktadır.</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>