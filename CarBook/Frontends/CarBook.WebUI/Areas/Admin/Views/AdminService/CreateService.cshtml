@model CreateServiceDto

@{
    ViewData["Title"] = "CreateService";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Hizmet Ekleme Formu</h4>
                        <p class="card-subtitle mb-4">Bu formu kullanarak sisteminize yeni hizmet ekleyebilirsiniz.</p>
                        <form method="post" asp-area="Admin" asp-controller="AdminService" asp-action="CreateService">
                            <div class="form-group">
                                <label for="exampleInputTitle">Başlık</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="title" placeholder="Hizmet başlığını giriniz...">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputDesc">İçerik</label>
                                <textarea rows="4" class="form-control" id="exampleInputDesc" asp-for="description" placeholder="Hizmet içeriğini giriniz..."></textarea>
                            </div>
                            <div class="form-group">
                                <label for="exampleInputFeature">İkon URL</label>
                                <input type="text" class="form-control" id="exampleInputModel" asp-for="iconUrl" placeholder="İkon dosya yolunu giriniz...">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

