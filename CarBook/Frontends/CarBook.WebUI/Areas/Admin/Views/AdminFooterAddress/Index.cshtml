@model List<ResultFooterAddressDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="mt-3">
                                <h4 class="card-title">Alt Adres Listesi</h4>
                                <p class="card-subtitle mb-4"><code class="text-info font-weight-bold font-size-13">Alt adres ile ilgili işlemlerinizi buradan gerçekleştirebilirsiniz.</code></p>
                            </div>

                            @if (!Model.Any() || Model == null)
                            {
                                <div class="mt-3">
                                    <a href="/Admin/AdminFooterAddress/CreateFooterAddress" class="btn btn-outline-info"><i class="fa fa-plus"></i> Yeni Alt Adres</a>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger" role="alert">
                                    Yeni Alt Adres Eklemek İçin Mevcut Alt Adres Bilgisini Siliniz
                                </div>
                            }

                        </div>
                        @if (Model.Any() && Model != null)
                        {
                            <div class="table-responsive">

                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Açıklama</th>
                                            <th>Adres</th>
                                            <th>Telefon</th>
                                            <th>Mail</th>
                                            <th>İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            count++;
                                            <tr>
                                                <th scope="row">@count</th>
                                                <td>@item.phone</td>
                                                <td>@item.email</td>
                                                <td>@(item.description.Length > 100 ? item.description.Substring(0, 100) + "" + "..." : item.description)</td>
                                                <td>@(item.address.Length > 100 ? item.address.Substring(0, 100) + "" + "..." : item.address)</td>
                                                <td>
                                                    <a href="/Admin/AdminFooterAddress/RemoveFooterAddress/@item.footerAddressId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                                    <a href="/Admin/AdminFooterAddress/UpdateFooterAddress/@item.footerAddressId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-dark" role="alert">
                                Herhangi bir alt adres bilgisi bulunamadı.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>