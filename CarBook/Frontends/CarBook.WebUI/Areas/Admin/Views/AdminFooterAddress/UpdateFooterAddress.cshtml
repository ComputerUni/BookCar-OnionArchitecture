@model UpdateFooterAddressDto

@{
    ViewData["Title"] = "UpdateFooterAddress";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Alt Adres Ekleme Formu</h4>
                        <p class="card-subtitle mb-4">Bu formu kullanarak sisteminize yeni alt adres bilgisi ekleyebilirsiniz.</p>
                        <form method="post" asp-area="Admin" asp-controller="AdminFooterAddress" asp-action="UpdateFooterAddress">
                            <input type="hidden" asp-for="footerAddressId" />
                            <div class="form-group">
                                <label for="exampleInputTitle">Açıklama</label>
                                <textarea class="form-control" id="exampleInputTitle" asp-for="description" placeholder="Alt adres açıklamasını giriniz..."></textarea>
                            </div>
                            <div class="form-group">
                                <label for="exampleInputTitle">Adres</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="address" placeholder="Adresi giriniz...">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputTitle">Telefon</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="phone" placeholder="Telefon numarasını giriniz...">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputTitle">E-posta</label>
                                <input type="email" class="form-control" id="exampleInputTitle" asp-for="email" placeholder="Email adresini giriniz...">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Güncelle</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

