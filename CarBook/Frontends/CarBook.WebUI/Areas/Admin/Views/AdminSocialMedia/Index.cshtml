@model List<ResultSocialMediaDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="mt-3">
                                <h4 class="card-title">Sosyal Medya Listesi</h4>
                                <p class="card-subtitle mb-4"><code class="text-info font-weight-bold font-size-13">Sosyal medya hesaplarıyla ile ilgili işlemlerinizi buradan gerçekleştirebilirsiniz.</code></p>
                            </div>

                            <div class="mt-3">
                                <a href="/Admin/AdminSocialMedia/CreateSocialMedia" class="btn btn-outline-info"><i class="fa fa-plus"></i> Yeni Sosyal Medya Hesabı</a>
                            </div>

                        </div>
                        @if (Model.Any() && Model != null)
                        {
                            <div class="table-responsive">

                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Ad</th>
                                            <th>İkon</th>
                                            <th>İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            count++;
                                            <tr>
                                                <th scope="row">@count</th>
                                                <td>@item.Name</td>
                                                <td><i class="@item.Icon" style="font-size: 22px;"></i></td>
                                                <td>
                                                    <a href="/Admin/AdminSocialMedia/RemoveSocialMedia/@item.SocialMediaId" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                                    <a href="/Admin/AdminSocialMedia/UpdateSocialMedia/@item.SocialMediaId" class="btn btn-outline-warning"><i class="fa fa-pencil-alt"></i></a>
                                                    <a href="/Admin/AdminSocialMedia/UpdateSocialMedia/@item.SocialMediaId" class="btn btn-outline-warning"><i class="fa fa-eye"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                Herhangi bir sosyal medya bilgisi bulunamadı.
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>