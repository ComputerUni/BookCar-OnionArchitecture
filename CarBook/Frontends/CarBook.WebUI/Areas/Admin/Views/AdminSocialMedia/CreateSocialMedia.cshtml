@model CreateSocialMediaDto

@{
    ViewData["Title"] = "CreateSocialMedia";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Sosyal Medya Oluşturma Formu</h4>
                        <p class="card-subtitle mb-4">Bu formu kullanarak sisteme sosyal medya bilgisi ekleyebilirsiniz.</p>
                        <form method="post" asp-area="Admin" asp-controller="AdminSocialMedia" asp-action="CreateSocialMedia">
                            <div class="form-group">
                                <label for="exampleInputTitle">Sosyal Medya Adı</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="Name" placeholder="Sosyal medya adını giriniz...">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputTitle">Sosyal Medya URL</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="Url" placeholder="Sosyal medya linkini giriniz...">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputTitle">Sosyal Medya İkon</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="Icon" placeholder="Sosyal medya ikon url giriniz...">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

