@using CarBook.Dto.LoginDtos
@model LoginAppUserDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap | CarBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #f8fafc;
                color: #1e293b;
            }

            .auth-wrapper {
                min-height: 100vh;
            }

            /* Sol Taraf: Sinematik Gece Sürüşü Görseli */
            .visual-side {
                background: linear-gradient(180deg, rgba(15, 23, 42, 0.5) 0%, rgba(15, 23, 42, 0.9) 100%), url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=85') center/cover no-repeat;
                position: relative;
            }

            .glass-badge {
                background: rgba(255, 255, 255, 0.12);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 16px;
            }

            .form-floating > .form-control {
                border-radius: 12px;
                border: 1.5px solid #e2e8f0;
                background-color: #f8fafc;
                height: calc(3.5rem + 2px);
                padding: 1rem 0.85rem;
            }

                .form-floating > .form-control:focus {
                    background-color: #fff;
                    border-color: #2563eb;
                    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
                }

            .form-floating > label {
                color: #64748b;
                padding: 1rem 0.85rem;
            }

            .btn-primary-gradient {
                background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
                border: none;
                padding: 0.9rem;
                font-weight: 600;
                border-radius: 12px;
                transition: all 0.3s ease;
            }

                .btn-primary-gradient:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 8px 20px -4px rgba(37, 99, 235, 0.45);
                }

            .form-check-input:checked {
                background-color: #2563eb;
                border-color: #2563eb;
            }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0 auth-wrapper">

            <div class="col-lg-6 col-xl-7 d-none d-lg-flex flex-column justify-content-between p-5 visual-side text-white">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary text-white p-2 rounded-3 d-inline-flex">
                            <i class="ri-roadster-fill fs-4"></i>
                        </div>
                        <span class="fs-4 fw-extrabold tracking-wide">Car<span class="text-primary-emphasis">Book</span></span>
                    </div>
                </div>

                <div class="my-auto py-5" style="max-width: 560px;">
                    <span class="badge bg-white/20 text-white rounded-pill px-3 py-2 mb-3 fw-semibold">
                        <i class="ri-key-2-fill text-warning me-1"></i> Kesintisiz Kiralama Deneyimi
                    </span>
                    <h1 class="display-5 fw-bold leading-tight mb-3">Yolculuğa Kaldığınız Yerden Devam Edin.</h1>
                    <p class="fs-5 text-light opacity-80">
                        Hesabınıza giriş yaparak aktif rezervasyonlarınızı yönetin veya seçkin filomuzdan dilediğiniz aracı saniyeler içinde kiralayın.
                    </p>

                    <div class="glass-badge p-4 mt-4 d-flex align-items-center gap-3">
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle d-flex align-items-center justify-content-center">
                            <i class="ri-steering-2-fill fs-3"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">500+ Premium Araç & 7/24 Destek</h6>
                            <p class="small text-white-50 mb-0">Türkiye genelinde dilediğiniz noktada teslim alma ve iade kolaylığı.</p>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center text-white-50 small border-top border-white-10 pt-3">
                    <span>&copy; 2026 CarBook Technologies. Tüm hakları saklıdır.</span>
                    <a href="/Default/Index" class="text-white text-decoration-none">Ana Sayfaya Dön <i class="ri-arrow-right-line"></i></a>
                </div>
            </div>

            <div class="col-lg-6 col-xl-5 d-flex align-items-center justify-content-center bg-white p-4 p-md-5">
                <div class="w-100" style="max-width: 440px;">

                    <div class="mb-4">
                        <h2 class="fw-bold tracking-tight text-slate-900 mb-1">Tekrar Hoş Geldiniz</h2>
                        <p class="text-muted small">Devam etmek için kullanıcı bilgilerinizi giriniz.</p>
                    </div>

                    <form method="post" asp-action="Index" asp-controller="Login">

                        <div class="form-floating mb-3">
                            <input type="text" asp-for="Username" class="form-control" id="floatingUsername" placeholder="Kullanıcı Adı" required />
                            <label for="floatingUsername">Kullanıcı Adı</label>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" asp-for="Password" class="form-control" id="floatingPassword" placeholder="••••••••" required />
                            <label for="floatingPassword">Şifre</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label small text-muted user-select-none" for="rememberMe">
                                    Beni hatırla
                                </label>
                            </div>
                            <a href="#" class="text-decoration-none small text-primary fw-medium">Şifremi unuttum</a>
                        </div>

                        <button type="submit" class="btn btn-primary btn-primary-gradient w-100 text-white mb-4">
                            <i class="ri-login-box-line me-1"></i> Giriş Yap
                        </button>

                        <div class="text-center">
                            <span class="text-muted small">Henüz bir hesabınız yok mu?</span>
                            <a href="/Register/Index" class="fw-semibold text-primary text-decoration-none small ms-1">Hemen Kayıt Olun</a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</body>
</html>