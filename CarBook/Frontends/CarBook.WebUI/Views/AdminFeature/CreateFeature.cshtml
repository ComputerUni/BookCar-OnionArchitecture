@model CreateFeatureDto

@{
    ViewData["Title"] = "CreateFeature";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Araç Özelliği Ekleme Formu</h4>
                        <p class="card-subtitle mb-4">Bu formu kullanarak sisteminize yeni araç özellikleri ekleyebilirsiniz.</p>
                        <form method="post">
                            <div class="form-group">
                                <label for="exampleInputFeature">Özellik</label>
                                <input type="text" class="form-control" id="exampleInputModel" asp-for="Name" placeholder="Araç özelliğini giriniz (Örn: Şerit Takip Asistanı, Panoramik Cam Tavan)">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>





