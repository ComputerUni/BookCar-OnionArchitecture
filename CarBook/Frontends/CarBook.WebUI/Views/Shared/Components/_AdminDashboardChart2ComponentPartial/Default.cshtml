@using Newtonsoft.Json
<script src="~/chart.js"></script>

<div class="col-lg-4">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title d-inline-block">Araç Marka Sayıları</h4>

            <div style="position: relative; height: 320px; width: 100%;">
    <canvas id="my2Chart"></canvas>
</div>

            <script>
                            (function() {

                                var ctx = document.getElementById('my2Chart').getContext('2d');
                                new Chart(ctx, {
                                    type: 'pie',
                                    data: {
                                        labels: @Html.Raw(JsonConvert.SerializeObject(ViewBag.BrandLabels)),
                                        datasets: [{
                                            label: 'Araç Sayısı',
                                            data: @Html.Raw(JsonConvert.SerializeObject(ViewBag.BrandCounts)),
                                            backgroundColor: [
                                                '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b',
                                                '#858796', '#6f42c1', '#fd7e14', '#20c997', '#0dcaf0'
                                            ],
                                            borderWidth: 2,
                                            borderColor: '#ffffff'
                                        }]
                                    },
                                    options: {
                                        responsive: true,
                                        maintainAspectRatio: false,
                                        plugins: {
                                            legend: {
                                                position: 'bottom',
                                                labels: { padding: 10, boxWidth: 10, font: { size: 11 } }
                                            }
                                        }
                                    }
                                });
                            })();
            </script>

            <div class="row text-center mt-4">
                <div class="col-6">
                    <h4>@ViewBag.TotalCarCount</h4>
                    <p class="text-muted mb-0">Araç Sayısı</p>
                </div>
                <div class="col-6">
                    <h4>@ViewBag.TotalBrandCount</h4>
                    <p class="text-muted mb-0">Mevcut Aracı Olan Marka Sayısı</p>
                </div>
            </div>
        </div>
    </div>
</div>
