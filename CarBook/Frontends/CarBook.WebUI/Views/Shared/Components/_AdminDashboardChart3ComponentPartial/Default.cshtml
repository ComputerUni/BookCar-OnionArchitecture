<script src="~/chart.js"></script>

<div class="col-lg-4">
    <div class="card shadow-sm border-0 h-80 mb-4">
        <div class="card-body d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Kategoriye Göre Bloglar</h4>
                    <span class="badge bg-light text-primary border">İçerik Dağılımı</span>
                </div>

                <div style="position: relative; height: 320px; width: 100%;">
                    <canvas id="my3Chart"></canvas>
                </div>
            </div>

            <script>
                            (function() {
                                var ctx = document.getElementById('my3Chart').getContext('2d');

                                var gradient = ctx.createLinearGradient(0, 0, 0, 240);
                                gradient.addColorStop(0, '#3b82f6');
                                gradient.addColorStop(1, '#93c5fd');

                                new Chart(ctx, {
                                    type: 'bar',
                                    data: {
                                        labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BlogLabels ?? new List<string>())),
                                        datasets: [{
                                            label: 'Blog Yazısı Sayısı',
                                            data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BlogCounts ?? new List<int>())),
                                            backgroundColor: gradient,
                                            borderRadius: 6, 
                                            borderSkipped: false,
                                            maxBarThickness: 32
                                        }]
                                    },
                                    options: {
                                        responsive: true,
                                        maintainAspectRatio: false,
                                        plugins: {
                                            legend: {
                                                display: false 
                                            },
                                            tooltip: {
                                                padding: 10,
                                                callbacks: {
                                                    label: function(context) {
                                                        return ' ' + context.parsed.y + ' Yazı';
                                                    }
                                                }
                                            }
                                        },
                                        scales: {
                                            x: {
                                                grid: {
                                                    display: false
                                                },
                                                ticks: {
                                                    font: {
                                                        size: 11
                                                    }
                                                }
                                            },
                                            y: {
                                                beginAtZero: true,
                                                grid: {
                                                    color: 'rgba(0, 0, 0, 0.05)'
                                                },
                                                ticks: {
                                                    stepSize: 1, 
                                                    precision: 0
                                                }
                                            }
                                        }
                                    }
                                });
                            })();
            </script>


            <div class="row text-center mt-3 pt-3 border-top">
                <div class="col-6">
                    <h4 class="mb-1 text-primary font-weight-bold">@(ViewBag.TotalBlogCount ?? 0)</h4>
                    <p class="text-muted small mb-0">Toplam Blog</p>
                </div>
                <div class="col-6">
                    <h4 class="mb-1 text-success font-weight-bold">@(ViewBag.TotalCategoryCount ?? 0)</h4>
                    <p class="text-muted small mb-0">Aktif Kategori</p>
                </div>
            </div>
        </div>
    </div>
</div>