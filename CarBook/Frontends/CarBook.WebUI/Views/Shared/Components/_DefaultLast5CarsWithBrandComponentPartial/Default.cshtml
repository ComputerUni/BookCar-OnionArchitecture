@model List<ResultLast5CarsWithBrands>

<section class="ftco-section ftco-no-pt bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 heading-section text-center ftco-animate mb-5">
                <span class="subheading">What we offer</span>
                <h2 class="mb-2">Öne Çıkan Araçlar</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="carousel-car owl-carousel">
                    @foreach (var item in Model)
                    {
                        <div class="item">
                            <div class="car-wrap rounded ftco-animate d-flex flex-column bg-white shadow-sm h-100">
                                <div class="img rounded-top d-flex align-items-end" style="background-image: url(@item.CoverImageUrl);">
                                </div>
                                <div class="text p-4 d-flex flex-column flex-grow-1">
                                    <h2 class="mb-2">
                                        <a href="/Car/CarDetail/@item.CarId">@item.BrandName @item.Model</a>
                                    </h2>

                                    <div class="d-flex mb-3">
                                        <span class="cat">@item.Transmission</span>
                                        <p class="price ml-auto font-weight-bold text-primary mb-0">
                                            @item.Km.ToString("N0") <span class="text-muted font-weight-normal">km</span>
                                        </p>
                                    </div>

                                    <div class="d-flex justify-content-between mb-4 text-muted small">
                                        <span><i class="flaticon-car mr-1"></i> @item.Fuel</span>
                                        <span><i class="flaticon-transportation mr-1"></i> @item.Seat Koltuk</span>
                                        <span><i class="flaticon-rent mr-1"></i> @item.Luggage Bagaj</span>
                                    </div>

                                    <div class="mt-auto">
                                        <p class="d-flex mb-0">
                                            <a href="/Car/BookCar/@item.CarId" class="btn btn-primary py-2 mr-1 flex-fill text-center">Hemen Kirala</a>
                                            <a href="/Car/CarDetail/@item.CarId" class="btn btn-secondary py-2 ml-1 flex-fill text-center">Detaylar</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
