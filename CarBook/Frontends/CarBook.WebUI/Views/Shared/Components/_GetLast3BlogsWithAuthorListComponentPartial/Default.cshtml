@model List<ResultLast3BlogsWithAuthors>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 heading-section text-center ftco-animate">
                <span class="subheading">Bloglar</span>
                <h2>Son Eklenen Bloglar</h2>
            </div>
        </div>
        <div class="row d-flex align-items-stretch">
            @foreach (var item in Model)
            {
                <div class="col-md-4 d-flex ftco-animate">
                    <div class="blog-entry w-100 d-flex flex-column justify-content-between">
                        <div>
                            <a href="blog-single.html" class="block-20 d-block" style="background-image: url('@item.CoverImageUrl'); height: 260px; background-size: cover; background-position: center;">
                            </a>
                            <div class="text pt-4">
                                <div class="meta mb-3">
                                    <div><a href="#">@item.CreatedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</a></div>
                                    <div><a href="#">@item.AuthorName</a></div>
                                    <div><a href="#" class="meta-chat"><span class="icon-chat"></span> 3</a></div>
                                </div>
                                <h3 class="heading mt-2"><a href="#">@item.Title</a></h3>
                            </div>
                        </div>
                        <div class="text pb-4 pt-0">
                            <p class="mb-0"><a href="#" class="btn btn-primary">Devamını Oku</a></p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>