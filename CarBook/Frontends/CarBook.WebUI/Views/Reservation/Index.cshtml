@model CreateReservationDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="col-md-12 block-9 mb-md-5">
    <form asp-controller="Reservation" asp-action="Index" method="post" class="bg-light p-5 p-md-5 contact-form rounded shadow-sm">
        <div class="card-header border-5">
            <h3 style="color:dimgray"><i class="fas fa-car-side"></i></i> Rezervasyon Formu</h3>
        </div>

        <div class="card-body shadow-lg border-5">
            <div class="row g-3 mb-3">
                <input type="hidden" asp-for="CarId" value="@ViewBag.v3" class="form-control bg-white" placeholder="Almak İstediğiniz Araba">

                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Adınız</label>
                    <input type="text" asp-for="Name" class="form-control" placeholder="Adınız" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Soyadınız</label>
                    <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız" required>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">E-Posta Adresi</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="ornek@mail.com" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Telefon Numarası</label>
                    <input type="tel" asp-for="Phone" class="form-control" placeholder="05XX XXX XX XX" required>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Alış Lokasyonu</label>
                    <select asp-for="PickUpLocationId" asp-items="@ViewBag.v" class="form-control location-dropdown">
                        <option value="" disabled selected>Lütfen Almak İstediğiniz Lokasyonu Seçiniz</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">İade Lokasyonu</label>
                    <select asp-for="DropOffLocationId" asp-items="@ViewBag.v" class="form-control location-dropdown">
                        <option value="" disabled selected>Lütfen Teslim Etmek İstediğiniz Lokasyonu Seçiniz</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Yaşınız</label>
                    <input type="number" asp-for="Age" min="18" max="99" class="form-control" placeholder="Örn: 25" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Ehliyet Veriliş Yılı / Deneyim (Yıl)</label>
                    <input type="number" asp-for="DriverLicenceYear" min="0" max="70" class="form-control" placeholder="Örn: 5" required>
                </div>
            </div>



            <div class="row g-3 mb-4">
                <div class="col-md-12">
                    <label class="form-label text-muted small fw-bold">Ek Notlar</label>
                    <textarea rows="5" asp-for="Description" class="form-control" placeholder="Varsa eklemek istedikleriniz, uçuş saati veya özel talepleriniz..."></textarea>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <button type="submit" class="btn btn-outline-secondary py-3 w-100 fw-bold shadow-sm">
                        Rezervasyonu Tamamla
                    </button>
                </div>
            </div>
        </div>

   

    </form>
</div>